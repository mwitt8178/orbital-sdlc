    "WafBlockedRequestsAlarm3EB2200B": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "WAF blocked requests rate is elevated - possible attack in progress",
        "AlarmName": "orbital-prod-waf-blocked-requests",
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "Region",
            "Value": "us-east-1",
          },
          {
            "Name": "Rule",
            "Value": "ALL",
          },
          {
            "Name": "WebACL",
            "Value": "orbital-prod-acl",
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "BlockedRequests",
        "Namespace": "AWS/WAFV2",
        "Period": 300,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "orbital:component",
            "Value": "waf",
          },
          {
            "Key": "orbital:env",
            "Value": "prod",
          },
          {
            "Key": "orbital:managed-by",
            "Value": "cdk",
          },
          {
            "Key": "orbital:stack",
            "Value": "hub",
          },
        ],
        "Threshold": 500,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "WafHttpApiAssociation8D4EF119": {
      "Properties": {
        "ResourceArn": {
          "Fn::Join": [
