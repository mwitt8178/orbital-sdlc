              "Metric": {
                "Dimensions": [
                  {
                    "Name": "ApiId",
                    "Value": {
                      "Ref": "ApiGwHttpApi88C101BA",
                    },
                  },
                ],
                "MetricName": "Count",
                "Namespace": "AWS/ApiGateway",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
        "Tags": [
          {
            "Key": "orbital:component",
            "Value": "observability",
          },
          {
            "Key": "orbital:env",
            "Value": "prod",
          },
          {
            "Key": "orbital:managed-by",
            "Value": "cdk",
          },
