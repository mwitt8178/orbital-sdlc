    "WafWafLoggingDA440506": {
      "Properties": {
        "LogDestinationConfigs": [
          {
            "Fn::GetAtt": [
              "WafWafLogGroupD60AECDC",
              "Arn",
            ],
          },
        ],
        "ResourceArn": {
          "Fn::GetAtt": [
            "WafWebAclBE24253C",
            "Arn",
          ],
        },
      },
      "Type": "AWS::WAFv2::LoggingConfiguration",
    },
    "WafWebAclBE24253C": {
      "Metadata": {
        "cdk_nag": {
          "rules_to_suppress": [
            {
              "id": "AwsSolutions-WAF1",
              "reason": "WAF shield advanced is out of scope for this tier; managed rules provide OWASP coverage.",
            },
            {
              "id": "AwsSolutions-WAF4",
              "reason": "AWS managed rule groups do not support custom metric names for individual rules.",
            },
          ],
        },
      },
      "Properties": {
        "DefaultAction": {
          "Allow": {},
        },
        "Description": "Orbital prod - Web ACL for API Gateway HTTP and WebSocket",
        "Name": "orbital-prod-acl",
        "Rules": [
          {
            "Name": "AWSManagedRulesAmazonIpReputationList",
            "OverrideAction": {
              "None": {},
            },
            "Priority": 0,
            "Statement": {
              "ManagedRuleGroupStatement": {
                "Name": "AWSManagedRulesAmazonIpReputationList",
                "VendorName": "AWS",
              },
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "MetricName": "orbital-prod-ip-reputation",
              "SampledRequestsEnabled": true,
            },
          },
          {
            "Name": "AWSManagedRulesCommonRuleSet",
            "OverrideAction": {
              "None": {},
            },
            "Priority": 1,
            "Statement": {
              "ManagedRuleGroupStatement": {
                "Name": "AWSManagedRulesCommonRuleSet",
                "VendorName": "AWS",
              },
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "MetricName": "orbital-prod-common-rules",
              "SampledRequestsEnabled": true,
            },
          },
          {
            "Name": "AWSManagedRulesKnownBadInputsRuleSet",
            "OverrideAction": {
              "None": {},
            },
            "Priority": 2,
            "Statement": {
              "ManagedRuleGroupStatement": {
                "Name": "AWSManagedRulesKnownBadInputsRuleSet",
                "VendorName": "AWS",
              },
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "MetricName": "orbital-prod-bad-inputs",
              "SampledRequestsEnabled": true,
            },
          },
          {
            "Action": {
              "Block": {},
            },
            "Name": "BlockMissingUserAgent",
            "Priority": 3,
            "Statement": {
              "NotStatement": {
                "Statement": {
                  "SizeConstraintStatement": {
                    "ComparisonOperator": "GE",
                    "FieldToMatch": {
                      "SingleHeader": {
                        "Name": "user-agent",
                      },
                    },
                    "Size": 1,
                    "TextTransformations": [
                      {
                        "Priority": 0,
                        "Type": "NONE",
                      },
                    ],
                  },
                },
              },
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "MetricName": "orbital-prod-missing-user-agent",
              "SampledRequestsEnabled": true,
            },
          },
          {
            "Action": {
              "Block": {},
            },
            "Name": "GeneralRateLimit",
            "Priority": 4,
            "Statement": {
              "RateBasedStatement": {
                "AggregateKeyType": "IP",
                "Limit": 5000,
              },
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "MetricName": "orbital-prod-rate-limit-general",
              "SampledRequestsEnabled": true,
            },
          },
          {
            "Action": {
              "Block": {},
            },
            "Name": "AuthEndpointRateLimit",
            "Priority": 5,
            "Statement": {
              "RateBasedStatement": {
                "AggregateKeyType": "IP",
                "Limit": 100,
                "ScopeDownStatement": {
                  "ByteMatchStatement": {
                    "FieldToMatch": {
                      "UriPath": {},
                    },
                    "PositionalConstraint": "STARTS_WITH",
                    "SearchString": "/trpc/auth",
                    "TextTransformations": [
                      {
                        "Priority": 0,
                        "Type": "LOWERCASE",
                      },
                    ],
                  },
                },
              },
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "MetricName": "orbital-prod-rate-limit-auth",
              "SampledRequestsEnabled": true,
            },
          },
        ],
        "Scope": "REGIONAL",
        "Tags": [
          {
            "Key": "orbital:component",
            "Value": "waf",
          },
          {
            "Key": "orbital:env",
            "Value": "prod",
          },
          {
            "Key": "orbital:managed-by",
            "Value": "cdk",
          },
          {
            "Key": "orbital:stack",
            "Value": "hub",
          },
        ],
        "VisibilityConfig": {
          "CloudWatchMetricsEnabled": true,
          "MetricName": "orbital-prod-waf",
          "SampledRequestsEnabled": true,
        },
      },
      "Type": "AWS::WAFv2::WebACL",
    },
