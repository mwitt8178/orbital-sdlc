    "ObservabilityApi5xxRateAlarm420AC84B": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "HTTP API 5xx error rate exceeded 1% - check Lambda function logs",
        "AlarmName": "orbital-mwitt-api-5xx-rate",
        "ComparisonOperator": "GreaterThanThreshold",
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "(errors / total) * 100",
            "Id": "expr_1",
            "Label": "API 5xx Rate (%)",
          },
          {
            "Id": "errors",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "ApiId",
                    "Value": {
                      "Ref": "ApiGwHttpApi88C101BA",
                    },
                  },
                ],
                "MetricName": "5XXError",
                "Namespace": "AWS/ApiGateway",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "total",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "ApiId",
                    "Value": {
                      "Ref": "ApiGwHttpApi88C101BA",
                    },
                  },
                ],
                "MetricName": "Count",
                "Namespace": "AWS/ApiGateway",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
        "Tags": [
          {
            "Key": "orbital:component",
            "Value": "observability",
          },
          {
            "Key": "orbital:env",
            "Value": "mwitt",
          },
          {
            "Key": "orbital:managed-by",
            "Value": "cdk",
          },
          {
            "Key": "orbital:stack",
            "Value": "hub",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ObservabilityAuroraConnectionsAlarm260152B1": {
