    "ObservabilityAlarmTopicF724909D": {
      "Properties": {
        "DisplayName": "Orbital mwitt - Operational Alarms",
        "Tags": [
          {
            "Key": "orbital:component",
            "Value": "observability",
          },
        ],
        "TopicName": "orbital-alarms-mwitt",
      },
      "Type": "AWS::SNS::Topic",
    },
    "ObservabilityApi5xxRateAlarm420AC84B": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "HTTP API 5xx error rate exceeded 1% - check Lambda function logs",
        "AlarmName": "orbital-mwitt-api-5xx-rate",
        "ComparisonOperator": "GreaterThanThreshold",
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "(errors / total) * 100",
            "Id": "expr_1",
            "Label": "API 5xx Rate (%)",
          },
          {
            "Id": "errors",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "ApiId",
                    "Value": "httpapi123",
                  },
                ],
                "MetricName": "5XXError",
                "Namespace": "AWS/ApiGateway",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
          {
            "Id": "total",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "ApiId",
                    "Value": "httpapi123",
                  },
                ],
                "MetricName": "Count",
                "Namespace": "AWS/ApiGateway",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
        "Tags": [
          {
            "Key": "orbital:component",
            "Value": "observability",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ObservabilityAuroraConnectionsAlarm260152B1": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "Aurora connection count is high - RDS Proxy pool may be exhausted",
        "AlarmName": "orbital-mwitt-aurora-connections",
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "DBClusterIdentifier",
            "Value": "orbital-mwitt-aurora",
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "DatabaseConnections",
        "Namespace": "AWS/RDS",
        "Period": 300,
        "Statistic": "Maximum",
        "Tags": [
          {
            "Key": "orbital:component",
            "Value": "observability",
          },
        ],
        "Threshold": 180,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ObservabilityAuroraCpuAlarm6E1123B0": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "Aurora CPU utilization exceeds 80% - consider scaling ACUs",
        "AlarmName": "orbital-mwitt-aurora-cpu",
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "DBClusterIdentifier",
            "Value": "orbital-mwitt-aurora",
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "CPUUtilization",
        "Namespace": "AWS/RDS",
        "Period": 300,
        "Statistic": "Average",
        "Tags": [
          {
            "Key": "orbital:component",
            "Value": "observability",
          },
        ],
        "Threshold": 80,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "ObservabilityCognitoSignInFailuresAlarm8A8B81AF": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "ObservabilityAlarmTopicF724909D",
          },
        ],
        "AlarmDescription": "Cognito sign-in failures rate elevated - possible credential stuffing",
        "AlarmName": "orbital-mwitt-cognito-signin-failures",
        "ComparisonOperator": "GreaterThanThreshold",
        "Dimensions": [
          {
            "Name": "UserPool",
            "Value": "us-east-1_TestPool",
          },
          {
            "Name": "UserPoolClient",
            "Value": "ALL",
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "SignInSuccesses",
        "Namespace": "AWS/Cognito",
        "Period": 60,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "orbital:component",
            "Value": "observability",
          },
        ],
        "Threshold": 10,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
