exports[`Snapshot prod stack template matches snapshot 1`] = `
{
  "Description": "Orbital Hub — prod environment (8-01: VPC + Cognito + DNS)",
  "Mappings": {
    "AWSCloudFrontPartitionHostedZoneIdMap": {
      "aws": {
        "zoneId": "Z2FDTNDATAQYW2",
      },
      "aws-cn": {
        "zoneId": "Z3RFFRIM2A3IF5",
      },
    },
  },
  "Outputs": {
    "ApiGwApiEndpoint1F7D28E6": {
      "Description": "Orbital prod API endpoint (custom domain)",
      "Export": {
        "Name": "OrbitalHub-prod-ApiEndpoint",
      },
      "Value": "https://api.orbital.team.dev",
    },
    "ApiGwHttpApiId3B734B43": {
      "Description": "Orbital prod HTTP API ID",
      "Export": {
        "Name": "OrbitalHub-prod-HttpApiId",
      },
      "Value": {
        "Ref": "ApiGwHttpApi88C101BA",
      },
    },
    "AuroraClusterEndpoint1C7B34FE": {
      "Description": "Orbital prod Aurora cluster writer endpoint",
      "Export": {
        "Name": "OrbitalHub-prod-AuroraEndpoint",
      },
      "Value": {
        "Fn::GetAtt": [
          "AuroraClusterD4EFE71C",
          "Endpoint.Address",
        ],
      },
    },
    "AuroraClusterReaderEndpoint12CD68CF": {
      "Description": "Orbital prod Aurora cluster reader endpoint",
      "Export": {
        "Name": "OrbitalHub-prod-AuroraReaderEndpoint",
      },
      "Value": {
        "Fn::GetAtt": [
          "AuroraClusterD4EFE71C",
          "ReadEndpoint.Address",
        ],
