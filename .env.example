# Orbital environment configuration
# Copy this to .env and fill in real values.

# Postgres
DATABASE_URL=postgres://orbital:orbital_dev_password@localhost:5432/orbital

# HTTP server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Anthropic (workers call the real API)
ANTHROPIC_API_KEY=

# Monday.com (real GraphQL API)
MONDAY_API_TOKEN=
MONDAY_WEBHOOK_SECRET=
# Monday board id — required for periodic reconciliation (every 5 min sweep
# that catches webhook drift per TRD-02 §13.3). If unset the reconciler is a
# no-op; webhook delivery still works.
MONDAY_BOARD_ID=

# Claude Code CLI binary (path used by orchestration to spawn workers)
CLAUDE_BIN=claude

# MCP gateway socket path
ORBITAL_MCP_GATEWAY_URL=unix:///tmp/orbital-mcp.sock

# Install root (defaults to ~/.orbital)
ORBITAL_HOME=

# Optional OTel exporter
OTEL_EXPORTER_OTLP_ENDPOINT=

# Round 3 S1 — CORS allowlist (comma-separated origins).
# Required in production; empty here causes a boot warning. In development,
# this is ignored (origin: true is used so any local dev server can call
# the API).
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Round 3 S4 — WebSocket session token.
# When set, every WS upgrade requires either an x-orbital-ws-token header
# or a ?token=... query param matching this value. If unset in dev, WS
# connections are accepted unauthenticated (with a loud boot warning).
# In production: strongly recommended to set this.
WS_SESSION_TOKEN=
