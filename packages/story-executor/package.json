{
  "name": "@orbital/story-executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Story-executor verification daemon. Picks up story.ready events, spawns Claude workers under a budget, opens real PRs, writes worker_runs.",
  "main": "src/main.js",
  "bin": {
    "orbital-story-executor": "src/main.js"
  },
  "scripts": {
    "start": "node src/main.js",
    "verify": "node scripts/verify-loop.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@aws-sdk/client-secrets-manager": "^3.1042.0",
    "pg": "^8.20.0",
    "ulid": "^2.4.0"
  },
  "devDependencies": {
    "vitest": "^2.1.9"
  }
}
