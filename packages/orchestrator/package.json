{
  "name": "@orbital/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./trpc": {
      "types": "./src/trpc/routers/index.ts",
      "default": "./dist/trpc/routers/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b && node ../../scripts/copy-skill-assets.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src test",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1041.0",
    "@aws-sdk/client-codecommit": "^3.1041.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1041.0",
    "@aws-sdk/client-dynamodb": "^3.1041.0",
    "@aws-sdk/client-kms": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/client-secrets-manager": "^3.750.0",
    "@aws-sdk/client-sns": "^3.1041.0",
    "@aws-sdk/rds-signer": "^3.750.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@noble/ed25519": "^2.2.0",
    "@noble/hashes": "^1.6.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.53.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@orbital/db": "*",
    "@orbital/domain": "*",
    "@orbital/types": "*",
    "@trpc/server": "^11.0.0-rc.660",
    "aws-xray-sdk-core": "^3.10.3",
    "drizzle-kit": "^0.28.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.0.0",
    "keytar": "^7.9.0",
    "micromatch": "^4.0.8",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.0",
    "prom-client": "^15.1.0",
    "tar-stream": "^3.1.0",
    "ulid": "^2.3.0",
    "uuidv7": "^1.0.2",
    "ws": "^8.18.0",
    "zod": "^3.24.0",
    "zstd-napi": "^0.0.10"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/tar-stream": "^3.1.3",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "undici": "^8.2.0",
    "vitest": "^2.1.0"
  }
}
