# Orbital Orchestrator — environment variables reference
# Copy to .env and fill in values. Never commit .env.

# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://orbital:orbital_dev_password@localhost:5432/orbital
PORT=3000
HOST=0.0.0.0

# ---- AI ----
# Required for live agent workers.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Monday.com ----
# Required for backlog sync.
MONDAY_API_TOKEN=
# Board id to reconcile against (numeric string from Monday URL).
MONDAY_BOARD_ID=
# HMAC-SHA256 secret set when registering the Monday webhook. Optional — webhook
# route is skipped at boot if absent.
MONDAY_WEBHOOK_SECRET=

# ---- GitHub (Round 4 / Round 5D) ----
# PAT or GitHub App token with repo + pull_request scopes.
GITHUB_API_TOKEN=ghp_...
# HMAC-SHA256 secret configured in the GitHub repo/org webhook settings.
# Optional — webhook route is skipped at boot if absent.
GITHUB_WEBHOOK_SECRET=

# ---- Security ----
CORS_ALLOWED_ORIGINS=http://localhost:5173
WS_SESSION_TOKEN=

# ---- Paths ----
ORBITAL_HOME=~/.orbital
CLAUDE_BIN=claude

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
