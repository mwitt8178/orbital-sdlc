{
  "name": "@orbital/api-lambda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stateless tRPC Lambda for the Orbital browser surface. Narrow router — no daemon code, no filesystem, no child_process. Single bundled handler.",
  "main": "dist/handler.mjs",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "cold-import-check": "node ../../scripts/lambda-cold-import-check.mjs dist/handler.mjs"
  },
  "dependencies": {
    "@orbital/db": "*",
    "@orbital/orchestrator": "*",
    "@trpc/server": "^11.0.0-rc.660"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1041.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
