# (CognitoUserPoolArn) + cognito-idp list-user-pool-clients.
# [Engineer-Principal · Opus · run-auth-login-001]
VITE_COGNITO_USER_POOL_ID=us-east-1_R89dMIxXb
VITE_COGNITO_USER_POOL_CLIENT_ID=32k8f80j12r5u896smd4oq3g78
