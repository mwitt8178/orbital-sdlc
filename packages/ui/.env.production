VITE_TRPC_URL=https://hhhfb8pid6.execute-api.us-east-1.amazonaws.com
# API Gateway WebSocket URL — stage path /$default. The UI's ws.ts detects the
# execute-api host and does NOT append /ws (which would 404 on upgrade).
VITE_WS_URL=wss://zc2367u5d1.execute-api.us-east-1.amazonaws.com/$default

# Cognito (orbital-mwitt). Public values — pool ID + SPA app client ID are
