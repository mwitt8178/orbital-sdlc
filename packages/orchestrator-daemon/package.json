{
  "name": "@orbital/orchestrator-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Long-running orchestrator daemon — runs in ECS Fargate with EFS mount. Spawns Claude workers, manages worktrees, runs the scheduler tick loop, owns agent-org git repo. NEVER serves HTTP requests.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@orbital/orchestrator": "*",
    "@aws-sdk/client-secrets-manager": "^3.750.0",
    "@aws-sdk/client-sns": "^3.1041.0",
    "@aws-sdk/client-sqs": "^3.1041.0",
    "@aws-sdk/rds-signer": "^3.750.0",
    "drizzle-orm": "^0.36.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
