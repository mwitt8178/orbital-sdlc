{
  "name": "@orbital/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JWT verification (Cognito JWKS cache) + PKI envelope verify + tenant_id claim extractors. Pure functions, no I/O at module load. Imported by api-lambda, install-lambda, daemon.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.0",
    "@noble/hashes": "^1.6.0",
    "@orbital/types": "*",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
